# Análisis con IA (configura al menos uno)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Transcripción de audio (configura al menos uno)
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# Cloudinary: el mismo cloud name se usa en cliente y servidor
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Verificación bíblica abierta (GetBible / dominio público)
BIBLE_API_BASE=https://query.getbible.net/v2
BIBLE_TRANSLATION=sse
BIBLE_TRANSLATION_LICENSE=Dominio público
BIBLE_VERIFY=true

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Proveedores opcionales de transcripción por URL/YouTube
SUPADATA_API_KEY=
TRANSCRIPT_SERVICE_URL=
TRANSCRIPT_SERVICE_TOKEN=
TRANSCRIPT_PROVIDER_ORDER=
